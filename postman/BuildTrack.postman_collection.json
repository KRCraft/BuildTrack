{
  "info": {
    "name": "BuildTrack API v1",
    "description": "Live contract: Base URL `{{baseUrl}}/api/v1`, Auth Bearer JWT + X-Company-ID header (UUID). Refresh via HttpOnly cookie at /api/v1/auth/refresh/. See docs/API_CONTRACT.md v1.1 (2026-09-20).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string", "description": "X-Company-ID UUID from GET /api/v1/companies/" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "budgetVersionId", "value": "", "type": "string" },
    { "key": "expenseId", "value": "", "type": "string" },
    { "key": "materialId", "value": "", "type": "string" },
    { "key": "locationId", "value": "", "type": "string" },
    { "key": "transferId", "value": "", "type": "string" },
    { "key": "reportId", "value": "", "type": "string" },
    { "key": "revisionId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.com\",\n  \"first_name\": \"Amina\",\n  \"last_name\": \"Karimova\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "refresh (cookie)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh/",
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] }
        },
        {
          "name": "logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] }
        }
      ]
    },
    {
      "name": "companies",
      "item": [
        { "name": "list my companies", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/companies/" } },
        {
          "name": "create company",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Karimov Stroy\",\n  \"slug\": \"karimov-stroy\",\n  \"currency_code\": \"UZS\"\n}" }
          }
        },
        { "name": "get company", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "invite member",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/invitations/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"pm@example.com\",\n  \"role\": \"PROJECT_MANAGER\"\n}" }
          }
        },
        {
          "name": "accept invitation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/invitations/accept/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<invitation-token>\"\n}" }
          }
        }
      ]
    },
    {
      "name": "projects",
      "item": [
        { "name": "list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/?page=1&search=&status=", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/projects/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tashkent Villa — Yunusabad\",\n  \"code\": \"BT-2026-001\",\n  \"client_name\": \"Karimov Stroy\",\n  \"status\": \"ACTIVE\",\n  \"budget_planned\": \"85000.00\",\n  \"currency_code\": \"UZS\",\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-12-15\",\n  \"location\": \"Tashkent, Yunusabad\"\n}" }
          }
        },
        { "name": "retrieve", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "update",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" }
          }
        },
        { "name": "archive", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/archive/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "assignments list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assignments/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "assign member",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assignments/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"membership\": \"<membership-uuid>\",\n  \"assignment_role\": \"PROJECT_MANAGER\"\n}" }
          }
        }
      ]
    },
    {
      "name": "budgets",
      "item": [
        { "name": "get project budget", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/budget/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "create budget", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/budget/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "create revision", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/budget/revisions/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "get version", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/budget-versions/{{budgetVersionId}}/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "add category",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/budget-versions/{{budgetVersionId}}/categories/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Foundation\",\n  \"planned_amount\": \"25000.00\"\n}" }
          }
        },
        { "name": "submit version", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/budget-versions/{{budgetVersionId}}/submit/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "approve version", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/budget-versions/{{budgetVersionId}}/approve/", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }], "body": { "mode": "raw", "raw": "{}" } } }
      ]
    },
    {
      "name": "expenses",
      "item": [
        { "name": "suppliers list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/suppliers/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create supplier",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/suppliers/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cement LLC\",\n  \"tax_id\": \"123456789\",\n  \"phone\": \"+998901234567\"\n}" }
          }
        },
        { "name": "expenses list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/expenses/?project_id={{projectId}}&page=1", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create expense (idempotent)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/expenses/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"project\": \"{{projectId}}\",\n  \"budget_category\": \"<category-uuid>\",\n  \"supplier\": \"<supplier-uuid>\",\n  \"amount\": \"1200.00\",\n  \"currency_code\": \"UZS\",\n  \"expense_date\": \"2026-09-20\",\n  \"description\": \"Cement purchase\"\n}" }
          }
        },
        { "name": "submit expense", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/submit/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "approve expense", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/expenses/{{expenseId}}/approve/", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }], "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Approved\"\n}" } } }
      ]
    },
    {
      "name": "inventory",
      "item": [
        { "name": "materials list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/materials/?search=", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create material",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/materials/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cement M400\",\n  \"code\": \"CEM-001\",\n  \"unit\": \"kg\",\n  \"minimum_stock_level\": \"100.00\"\n}" }
          }
        },
        { "name": "locations list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/inventory/locations/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "receipt",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/inventory/receipt/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"material\": \"{{materialId}}\",\n  \"location\": \"{{locationId}}\",\n  \"quantity\": \"500.00\",\n  \"reason\": \"Initial stock\"\n}" }
          }
        },
        { "name": "balances", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/inventory/balances/?project={{projectId}}&low_stock=false", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "transactions", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/inventory/transactions/?page=1", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create transfer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/inventory/transfers/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"source_location\": \"{{locationId}}\",\n  \"destination_location\": \"<dest-uuid>\",\n  \"purpose\": \"SITE_TRANSFER\",\n  \"items\": [{ \"material\": \"{{materialId}}\", \"quantity_requested\": \"100.00\" }]\n}" }
          }
        },
        { "name": "dispatch transfer", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/inventory/transfers/{{transferId}}/dispatch/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }, { "key": "Idempotency-Key", "value": "{{$guid}}" }] } },
        { "name": "receive transfer", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/inventory/transfers/{{transferId}}/receive/", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"id\": \"<item-uuid>\", \"quantity\": \"100.00\" }]\n}" } } }
      ]
    },
    {
      "name": "workforce",
      "item": [
        { "name": "workers list", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/workers/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create worker",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/workers/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Jasur Aliyev\",\n  \"phone\": \"+998901111111\",\n  \"specialty\": \"Mason\"\n}" }
          }
        },
        { "name": "project workers", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/workers/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } }
      ]
    },
    {
      "name": "reports",
      "item": [
        { "name": "list reports", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/reports/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create report",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/reports/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"report_date\": \"2026-09-20\",\n  \"work_completed\": \"Foundation poured\",\n  \"progress_delta\": \"5.00\",\n  \"worker_count\": 12\n}" }
          }
        },
        { "name": "get report", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/reports/{{reportId}}/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        {
          "name": "create revision",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/reports/{{reportId}}/revisions/",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Company-ID", "value": "{{companyId}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"revision_reason\": \"Corrected progress\"\n}" }
          }
        },
        { "name": "submit revision", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/revisions/{{revisionId}}/submit/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "approve revision", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/revisions/{{revisionId}}/approve/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } }
      ]
    },
    {
      "name": "dashboard & audit",
      "item": [
        { "name": "company dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/dashboard/company/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "project dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/dashboard/projects/{{projectId}}/", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } },
        { "name": "audit logs", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/audit-logs/?page=1", "header": [{ "key": "X-Company-ID", "value": "{{companyId}}" }] } }
      ]
    }
  ]
}
